# Tavily API Keys (for web search)
TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_API_KEY2=your_tavily_api_key_2_here

#######################################################

# Groq API Keys (comma-separated for rotation)
GROQ_KEYS=your_groq_key_1,your_groq_key_2,your_groq_key_3

# OpenRouter API Key
OPENROUTER_KEYS=your_openrouter_key_here

# DAHL API Key
DAHL_API_KEY=your_dahl_api_key_here

########################################################

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database URL (PostgreSQL with psycopg)
DATABASE_URL=postgresql+psycopg://user:password@host:port/database?sslmode=require

# WhatsApp Business Number
WHATSAPP_NUMBER=your_whatsapp_number_here

# Admin Credentials
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD_HASH=your_bcrypt_hashed_password_here

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRE_MINUTES=480

######

# Cloudinary Configuration (for image uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret